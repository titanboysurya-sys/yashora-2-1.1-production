# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# UNSPLASH_ACCESS_KEY: Access key for high-quality Unsplash image search.
UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY

# UNSPLASH_SECRET_KEY: Secret key for high-quality Unsplash image search.
UNSPLASH_SECRET_KEY=YOUR_UNSPLASH_SECRET_KEY

# PEXELS_API_KEY: Required for Pexels stock video/photo search query matching.
PEXELS_API_KEY=YOUR_PEXELS_API_KEY

# PIXABAY_API_KEY: Required for Pixabay search matching.
PIXABAY_API_KEY=YOUR_PIXABAY_API_KEY
