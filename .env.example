# 1. Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Pexels API Key (Stock Videos & Images)
PEXELS_API_KEY=your_pexels_api_key_here

# 3. Pixabay API Key (Stock Videos & Images)
PIXABAY_API_KEY=your_pixabay_api_key_here

# 4. Unsplash Access Key (High-Res Images)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# 5. Unsplash Secret Key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# 6. ElevenLabs API Key (Ultra-Realistic AI Voice Narration)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 7. Spoonacular API Key (Food & Culinary Recipes)
SPOONACULAR_API_KEY=your_spoonacular_api_key_here
